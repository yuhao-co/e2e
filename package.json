{
  "name": "kiko-midscene-mlx",
  "version": "0.1.0",
  "private": true,
  "description": "E2E tests using Midscene.js with a local MLX-served Qwen2.5-VL model",
  "scripts": {
    "mlx:server": "bash scripts/start-mlx-server.sh",
    "mlx:smoke": "bash scripts/mlx-smoke.sh",
    "generate:weekly-diff-cases": "tsx scripts/generate-cases-from-weekly-diff.ts",
    "weekly-diff": "/bin/zsh scripts/run-weekly-diff-case-generator.sh",
    "weekly-diff:run": "/bin/zsh scripts/run-weekly-diff-case-generator.sh",
    "weekly-diff:no-bugs": "RUN_BUG_DETECTION=0 /bin/zsh scripts/run-weekly-diff-case-generator.sh",
    "notify:run": "tsx scripts/run-with-lark-notify.ts",
    "test": "playwright test",
    "test:web:retained": "playwright test tests/web/traveloka-flight-form-contracts.spec.ts tests/web/traveloka-flight-weekly-diff-20*.spec.ts",
    "test:lark": "npm run notify:run -- --label \"Playwright test\" -- npx playwright test",
    "test:web:retained:lark": "npm run notify:run -- --label \"Retained web tests\" -- npx playwright test tests/web/traveloka-flight-form-contracts.spec.ts tests/web/traveloka-flight-weekly-diff-20*.spec.ts",
    "test:headed": "playwright test --headed",
    "test:bugs:generic": "playwright test tests/web/traveloka-generic-bug-detection.spec.ts",
    "weekly-diff:lark": "npm run weekly-diff:run",
    "weekly-diff:prd": "python3 scripts/generate-prd-enhanced.py",
    "weekly-diff:integrated": "/bin/zsh scripts/run-weekly-diff-with-bug-detection.sh",
    "weekly:quality:plan": "tsx scripts/plan-weekly-quality-scenarios.ts",
    "weekly:quality:triage": "tsx scripts/triage-weekly-failures.ts",
    "weekly:quality:calibrate": "tsx scripts/calibrate-weekly-quality.ts",
    "weekly:quality:promote": "tsx scripts/promote-weekly-learning.ts",
    "weekly:quality:notify": "tsx scripts/send-weekly-quality-notification.ts",
    "bug-data:stats": "npx ts-node scripts/bug-detection-collector.ts stats",
    "bug-data:export": "npx ts-node scripts/bug-detection-collector.ts export",
    "bug-data:validate": "npx ts-node scripts/bug-detection-collector.ts validate",
    "model:train": "python3 scripts/train-bug-classification-model.py --train",
    "model:evaluate": "python3 scripts/train-bug-classification-model.py --evaluate",
    "analyze:p0": "npx tsx scripts/analyze-p0-bugs.ts",
    "analyze:p0:watch": "watch 'npm run analyze:p0' config/p0-detection-rules.json tests/lib/generic-bug-detector.ts",
    "report": "playwright show-report",
    "workflow": "/bin/zsh scripts/run-complete-workflow.sh",
    "workflow:demo" : "/bin/zsh scripts/demo-refresh-auth-session.sh",
    "explore:gaps" : "tsx scripts/explore-coverage-gaps.ts",
    "explore:gaps:dry" : "tsx scripts/explore-coverage-gaps.ts --dry-run",
    "explore:gaps:list" : "tsx scripts/explore-coverage-gaps.ts --list-gaps",
    "explore:run" : "npm run explore:gaps && npx playwright test tests/web/traveloka-flight-weekly-diff-20*.spec.ts tests/web/traveloka-flight-explore-*.spec.ts --workers=1",
    "explore:run:lark" : "npm run explore:gaps && npx tsx scripts/run-with-lark-notify.ts --label 'Daily accumulated regression' -- npx playwright test tests/web/traveloka-flight-weekly-diff-20*.spec.ts tests/web/traveloka-flight-explore-*.spec.ts --workers=1",
    "mutation:audit": "tsx scripts/mutation-audit.ts",
    "test:staging:payment" : "npx playwright test tests/web/traveloka-flight-booking-payment-e2e.spec.ts --workers=1",
    "test:staging:payment:headed" : "npx playwright test tests/web/traveloka-flight-booking-payment-e2e.spec.ts --workers=1 --headed",
    "maestro:android:generate": "tsx scripts/generate-maestro-android.ts",
    "maestro:android:generate:dry": "tsx scripts/generate-maestro-android.ts --dry-run",
    "maestro:android:run": "tsx scripts/run-maestro-android.ts",
    "maestro:android:run:p0": "tsx scripts/run-maestro-android.ts --priority p0",
    "maestro:android:run:all": "tsx scripts/run-maestro-android.ts --all",
    "maestro:android:fix": "tsx scripts/fix-maestro-android-failures.ts",
    "maestro:android:fix:verify": "tsx scripts/fix-maestro-android-failures.ts --verify",
    "maestro:android": "npm run maestro:android:generate && npm run maestro:android:run && npm run maestro:android:fix",
    "android:workflow": "tsx scripts/android-diff-workflow.ts",
    "android:workflow:full": "tsx scripts/android-diff-workflow.ts --full",
    "android:workflow:dry": "tsx scripts/android-diff-workflow.ts --dry-run",
    "android:workflow:p0": "tsx scripts/android-diff-workflow.ts --priority p0"
  },
  "devDependencies": {
    "@midscene/android": "^1.7.7",
    "@midscene/web": "^1.0.0",
    "@playwright/test": "^1.59.1",
    "adbkit": "^2.11.1",
    "dotenv": "^16.4.5",
    "openai": "^6.35.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
