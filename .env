# Midscene + local MLX (Qwen2.5-VL-7B-Instruct-4bit) configuration
# Loaded by playwright.config.ts via dotenv.

# OpenAI-compatible endpoint exposed by mlx-vlm's HTTP server.
MIDSCENE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# mlx-vlm does not enforce an API key; any non-empty string keeps the SDK happy.
MIDSCENE_MODEL_API_KEY=mlx-local-no-auth
MIDSCENE_MODEL_NAME=mlx-community/Qwen2.5-VL-7B-Instruct-4bit
# Tells Midscene how to interpret coordinates returned by the model.
MIDSCENE_MODEL_FAMILY=qwen2.5-vl

# Local 7B-4bit model is slow; raise hard timeout to 10 minutes per call.
MIDSCENE_MODEL_TIMEOUT=600000
MIDSCENE_MODEL_MAX_TOKENS=4096
MIDSCENE_MODEL_TEMPERATURE=0
MIDSCENE_PREFERRED_LANGUAGE=English

# Where Midscene drops its run artifacts (HTML report, logs, screenshots, traces).
MIDSCENE_RUN_DIR=midscene_run

# Lark bot webhook for run-with-lark-notify.ts notifications.
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/1b221b9a-a93d-4d97-8eb6-c72db964c6e9
