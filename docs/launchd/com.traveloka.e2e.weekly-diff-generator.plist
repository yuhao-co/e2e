<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.traveloka.e2e.weekly-diff-generator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/yu.hao/Desktop/task/e2e &amp;&amp; CMD=(npx tsx scripts/generate-cases-from-weekly-diff.ts --base-ref "$BASE_REF" --since-days "$SINCE_DAYS" --output-dir "$OUTPUT_DIR") &amp;&amp; if [[ -n "$FOCUS_DOMAIN" ]]; then CMD+=(--focus-domain "$FOCUS_DOMAIN"); fi &amp;&amp; if [[ "$EMIT_WEB_SPEC" == "1" ]]; then CMD+=(--emit-web-spec); fi &amp;&amp; if [[ -n "$TARGET_REPO_URL" ]]; then CMD+=(--repo-url "$TARGET_REPO_URL" --repo-cache-dir "$TARGET_REPO_CACHE_DIR"); else CMD+=(--repo-path "$TARGET_REPO_PATH"); fi &amp;&amp; "${CMD[@]}"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yu.hao/.nvm/versions/node/v20.20.2/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>REPO_ROOT</key>
    <string>/Users/yu.hao/Desktop/task/e2e</string>
    <key>TARGET_REPO_PATH</key>
    <string></string>
    <key>TARGET_REPO_URL</key>
    <string>https://github.com/traveloka/www</string>
    <key>TARGET_REPO_CACHE_DIR</key>
    <string>.cache/weekly-diff-repos</string>
    <key>FOCUS_DOMAIN</key>
    <string>flight-search</string>
    <key>EMIT_WEB_SPEC</key>
    <string>1</string>
    <key>BASE_REF</key>
    <string>origin/master</string>
    <key>SINCE_DAYS</key>
    <string>7</string>
    <key>OUTPUT_DIR</key>
    <string>generated-cases/weekly-diff</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>32</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/yu.hao/Desktop/task/e2e</string>

  <key>StandardOutPath</key>
  <string>/Users/yu.hao/Desktop/task/e2e/logs/weekly-diff-generator.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yu.hao/Desktop/task/e2e/logs/weekly-diff-generator.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>