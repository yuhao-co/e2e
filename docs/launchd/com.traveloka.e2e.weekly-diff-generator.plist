<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.traveloka.e2e.weekly-diff-generator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/yu.hao/Desktop/task/e2e &amp;&amp; CMD=(npx tsx scripts/weekly-diff-workflow.ts --since-days "$SINCE_DAYS") &amp;&amp; if [[ -n "$BASE_REF" ]]; then CMD+=(--base-ref "$BASE_REF"); fi &amp;&amp; if [[ -n "$TARGET_REPO_CACHE_DIR" ]]; then CMD+=(--repo-cache-dir "$TARGET_REPO_CACHE_DIR"); fi &amp;&amp; if [[ "$EMIT_WEB_SPEC" == "1" ]]; then CMD+=(--emit-web-spec); fi &amp;&amp; if [[ "$FETCH_WEEKLY_DIFF" == "0" ]]; then CMD+=(--no-fetch); fi &amp;&amp; "${CMD[@]}"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/yu.hao/.nvm/versions/node/v20.20.2/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>REPO_ROOT</key>
    <string>/Users/yu.hao/Desktop/task/e2e</string>
    <key>TARGET_REPO_PATH</key>
    <string></string>
    <key>TARGET_REPO_URL</key>
    <string>https://github.com/traveloka/www</string>
    <key>TARGET_REPO_CACHE_DIR</key>
    <string>.cache/weekly-diff-repos</string>
    <key>FOCUS_DOMAIN</key>
    <string>flight-search,flight-booking</string>
    <key>EMIT_WEB_SPEC</key>
    <string>1</string>
    <key>BASE_REF</key>
    <string>origin/master</string>
    <key>SINCE_DAYS</key>
    <string>7</string>
    <key>FETCH_WEEKLY_DIFF</key>
    <string>1</string>
    <key>OUTPUT_DIR</key>
    <string>generated-cases/weekly-diff</string>
    <key>LARK_WEBHOOK_URL</key>
    <string>https://open.larksuite.com/open-apis/bot/v2/hook/1b221b9a-a93d-4d97-8eb6-c72db964c6e9</string>
  </dict>

