appId: com.traveloka.android.staging
---

# Navigate to the home screen and dismiss onboarding if present
- launchApp
- tapOn:
    id: "button_continue" # Dismiss onboarding (if present)
    optional: true

# Tap on the "Flights" tile to navigate to the search form
- tapOn:
    id: "flights_tile"

# Tap the "Search" button to navigate to the flight search results
- tapOn:
    id: "btn_search"

# Wait for the flight search results to load
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"

# Open the sort tray by tapping the sort button
- tapOn:
    id: "flight_result_v4_sort_button"

# Tap the first sort option (Cheapest) inside the sort tray
- tapOn:
    id: "radio_button"
    index: 0

# Wait for the results to reload
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"

# Assert that flight cards are still visible after sorting
- assertVisible:
    id: "flight_result_v4_inventory_card"