appId: com.traveloka.android.staging
---

# Step 1: Navigate to search results
- launchApp
- tapOn:
    id: "flights_tile"  # Tap "Flights" tile on home screen
- tapOn:
    id: "btn_search"  # Tap "Search" button on search form
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"  # Wait for flight cards to appear (up to 30s)

# Step 2: Open filter dialog
- tapOn:
    id: "flight_result_v4_quick_filter_cell"  # Tap any quick filter chip to open filter dialog
- extendedWaitUntil:
    id: "layout_filter_dialog"  # Wait for filter dialog to appear

# Step 3: Apply 1-stop filter
- tapOn:
    id: "button_one_transit"  # Tap "1 Stop" button in filter dialog
- tapOn:
    id: "tvResult"  # Tap "Apply" button to apply the filter

# Step 4: Wait for results to reload
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"  # Wait for flight cards to reload

# Step 5: Verify success criteria
- assertVisible:
    id: "flight_result_v4_inventory_card"  # Ensure flight cards are still visible after applying filter
- assertNotVisible:
    id: "layout_filter_dialog"  # Ensure filter dialog is closed