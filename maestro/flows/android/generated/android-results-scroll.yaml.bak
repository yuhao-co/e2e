appId: com.traveloka.android.staging
---

# Navigate to the search results screen
- launchApp
- assertVisible:
    id: "search_tab"  # Verify app launched to home screen
- tapOn:
    id: "search_tab"  # Tap "Flights" tile on home screen
- assertVisible:
    id: "layout_search_form"  # Verify search form is visible
- tapOn:
    id: "btn_search"  # Tap "Search" button to navigate to results
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"  # Wait for flight cards to appear (up to 30s)

# Scroll through results
- scroll  # Swipe UP to scroll and load more cards
- scroll  # Swipe UP again to continue scrolling

# Verify cards are still visible after scrolling
- assertVisible:
    id: "flight_result_v4_inventory_card"  # Ensure flight cards are still visible after scrolling