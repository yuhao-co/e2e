appId: com.traveloka.android.staging
---

# Test Case ID: android-results-price-calendar
# Name: View Price Calendar
# Description: Verify that tapping the date widget opens the price calendar view.
# Priority: P1

# Step 1: Launch the app and navigate to the home screen
- launchApp

# Step 2: Dismiss optional onboarding by tapping "Continue" (if present)
- tapOn:
    id: "button_continue"
  optional: true

# Step 3: Tap the "Flights" tile on the home screen to navigate to the search form
- tapOn:
    id: "flights_tile"

# Step 4: Verify the search form is displayed with "Singapore (SIN)" pre-filled as the origin
- assertVisible:
    id: "search_tab"
- assertVisible: "Singapore (SIN)"

# Step 5: Tap the "Search" button to navigate to the flight search results
- tapOn:
    id: "btn_search"

# Step 6: Wait for the flight search results to load (up to 30 seconds)
- extendedWaitUntil:
    timeout: 30000
    assertCondition:
      assertVisible:
        id: "flight_result_v4_inventory_card"

# Step 7: Tap the date widget to open the price calendar
- tapOn:
    id: "flight_result_v4_date_flow_row"

# Step 8: Wait for the price calendar view to appear
- extendedWaitUntil:
    timeout: 10000
    assertCondition:
      assertVisible:
        id: "price_calendar_view"

# Step 9: Take a screenshot for visual verification
- takeScreenshot