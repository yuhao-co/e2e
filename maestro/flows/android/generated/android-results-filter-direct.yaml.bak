appId: com.traveloka.android.staging
---

# Navigate to the search results page
- launchApp
- tapOn:
    id: "flights_tile" # Tap on the "Flights" tile on the home screen
- tapOn:
    id: "btn_search" # Tap on the "Search" button in the search form
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card" # Wait for flight cards to appear (up to 30s)

# Open the filter dialog
- tapOn:
    id: "flight_result_v4_quick_filter_cell" # Tap the first quick filter chip to open the filter dialog
- extendedWaitUntil:
    id: "layout_filter_dialog" # Wait for the filter dialog to appear (up to 10s)

# Apply the "Direct" filter
- tapOn:
    id: "button_direct" # Tap the "Direct" button in the filter dialog
- tapOn:
    id: "tvResult" # Tap the "Apply" button to apply the filter

# Verify the results after applying the filter
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card" # Wait for the results to reload
- assertVisible:
    id: "flight_result_v4_inventory_card" # Assert that at least one flight card is visible after applying the filter