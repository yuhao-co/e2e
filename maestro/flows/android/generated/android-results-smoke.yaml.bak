appId: com.traveloka.android.staging
---

# Step 1: Launch the app
- launchApp

# Step 2: Dismiss onboarding if visible
- runFlowIfVisible:
    id: "button_continue"
    flow:
      - tapOn:
          id: "button_continue"

# Step 3: Tap "Flights" tile on the home screen
- tapOn:
    text: "Flights"

# Step 4: Tap "Search" button on the search form
- tapOn:
    id: "btn_search"

# Step 5: Wait for the results page to load (up to 30 seconds)
- extendedWaitUntil:
    id: "flight_result_v4_navbar_toolbar_title"
    timeout: 30000

# Step 6: Wait for the first flight card to appear
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"
    timeout: 30000

# Step 7: Assert the results page is visible
- assertVisible:
    id: "flight_result_v4_navbar_toolbar_title"

# Step 8: Assert at least one flight card is visible
- assertVisible:
    id: "flight_result_v4_inventory_card"