appId: com.traveloka.android.staging
---

# Step 1: Launch the app and navigate to the home screen
- launchApp

# Step 2: Dismiss optional onboarding if present
- optional:
    - tapOn:
        id: "button_continue"

# Step 3: Tap "Flights" tile on the home screen
- tapOn:
    id: "flights_tile"

# Step 4: Wait for the search form to load
- assertVisible:
    id: "layout_search_form"

# Step 5: Tap the "Search" button to navigate to the results page
- tapOn:
    id: "btn_search"

# Step 6: Wait for the flight search results to load
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"

# Step 7: Tap a quick filter chip to open the filter dialog
- tapOn:
    id: "flight_result_v4_quick_filter_cell"

# Step 8: Wait for the filter dialog to appear
- assertVisible:
    id: "layout_filter_dialog"

# Step 9: Scroll to the "Time" filter section
- scrollUntilVisible:
    id: "layer_time"

# Step 10: Tap the "Morning Departure" button
- tapOn:
    id: "button_departure_morning"

# Step 11: Tap the "Apply" button to apply the filter
- tapOn:
    id: "tvResult"

# Step 12: Wait for the results to reload
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card"

# Success Criteria: Verify that the morning departure filter is applied
- assertVisible:
    id: "flight_result_v4_inventory_card_connector_view"