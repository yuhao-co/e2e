appId: com.traveloka.android.staging
---

# Navigate to the search results screen
- launchApp
- tapOn:
    id: "flights_tile" # Tap on the "Flights" tile on the home screen
- tapOn:
    id: "btn_search" # Tap on the "Search" button in the search form
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card" # Wait for flight cards to appear (up to 30s)

# Open the filter dialog
- tapOn:
    id: "flight_result_v4_quick_filter_cell" # Tap on a quick filter chip to open the filter dialog
- extendedWaitUntil:
    id: "layout_filter_dialog" # Wait for the filter dialog to appear

# Apply the "Direct" filter
- tapOn:
    id: "button_direct" # Tap on the "Direct" filter button
- tapOn:
    id: "tvResult" # Tap on the "Apply" button to apply the filter
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card" # Wait for the results to reload

# Open the filter dialog again
- tapOn:
    id: "flight_result_v4_quick_filter_cell" # Tap on a quick filter chip to open the filter dialog
- extendedWaitUntil:
    id: "layout_filter_dialog" # Wait for the filter dialog to appear

# Reset all filters
- tapOn:
    id: "tvReset" # Tap on the "Reset" button to clear all filters
- tapOn:
    id: "tvResult" # Tap on the "Apply" button to apply with no filters
- extendedWaitUntil:
    id: "flight_result_v4_inventory_card" # Wait for the results to reload

# Verify that the full result set is restored
- assertVisible:
    id: "flight_result_v4_inventory_card" # Assert that flight cards are visible again